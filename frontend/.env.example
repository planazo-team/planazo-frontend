# Modo de datos del frontend
#   mock  → servicios simulados en el navegador (por defecto, no requiere backend)
#   live  → llama al API Gateway y al Realtime Gateway reales
NEXT_PUBLIC_API_MODE=mock

# Solo se usan en modo live
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081/ws
NEXT_PUBLIC_GAME_URL=ws://localhost:8082
