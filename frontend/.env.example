# Modo de datos del frontend
#   mock  → servicios simulados en el navegador (por defecto, no requiere backend)
#   live  → llama al API Gateway y al Realtime Gateway reales
NEXT_PUBLIC_API_MODE=mock

# Inicio de sesión: únicamente con Google. Client ID de OAuth (tipo «Aplicación
# web») de Google Cloud Console; el mismo GOOGLE_CLIENT_ID del gateway. En la
# consola hay que autorizar los orígenes http://localhost:3000 y la URL de
# Vercel. Sin él, en modo mock se entra con un nombre (solo para la demo) y en
# modo live no se puede entrar.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Solo se usan en modo live. La única obligatoria es NEXT_PUBLIC_API_URL:
# sin NEXT_PUBLIC_REALTIME_URL la app funciona solo por HTTP (sin eventos en
# vivo) y sin NEXT_PUBLIC_GAME_URL no hay partida. Se agregan cuando esos
# servicios estén desplegados.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081/ws
NEXT_PUBLIC_GAME_URL=ws://localhost:8082
