# Modo de datos del frontend
#   mock  → servicios simulados en el navegador (por defecto, no requiere backend)
#   live  → llama al API Gateway y al Realtime Gateway reales
NEXT_PUBLIC_API_MODE=mock

# Configuración de Firebase Authentication (planazo-auth)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB5gP2jSP8VKafFsfhs9cvjYJaAtYBI-04
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=planazo-auth.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=planazo-auth
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=planazo-auth.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=601482275182
NEXT_PUBLIC_FIREBASE_APP_ID=1:601482275182:web:5c364ca744b6af92e7797f

# Client ID de OAuth de Google (opcional si se usa Firebase Auth directamente)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Solo se usan en modo live. La única obligatoria es NEXT_PUBLIC_API_URL:
# sin NEXT_PUBLIC_REALTIME_URL la app funciona solo por HTTP (sin eventos en
# vivo) y sin NEXT_PUBLIC_GAME_URL no hay partida. Se agregan cuando esos
# servicios estén desplegados.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8081/ws
NEXT_PUBLIC_GAME_URL=ws://localhost:8082
